{
  "mcpServers": {
    "mcp-server-linkedin": {
      "command": "uvx",
      "args": [
        "mcp-server-linkedin@latest"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300",
        "TEMP": "C:\\Users\\seenu\\.linkedin-mcp\\installer-temp",
        "TMP": "C:\\Users\\seenu\\.linkedin-mcp\\installer-temp",
        "TMPDIR": "C:\\Users\\seenu\\.linkedin-mcp\\installer-temp"
      }
    },
    "mcp-server-linkedin-rishi": {
      "command": "uvx",
      "args": [
        "mcp-server-linkedin@latest",
        "--user-data-dir",
        "C:\\Users\\seenu\\.linkedin-mcp-rishi\\profile"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300",
        "TEMP": "C:\\Users\\seenu\\.linkedin-mcp\\installer-temp",
        "TMP": "C:\\Users\\seenu\\.linkedin-mcp\\installer-temp",
        "TMPDIR": "C:\\Users\\seenu\\.linkedin-mcp\\installer-temp"
      }
    },
    "code-review-graph": {
